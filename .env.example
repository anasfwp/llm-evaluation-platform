# Copy to .env and fill in only what you use. Never commit .env.
#
# The CLI and the deterministic fake provider need no environment variables.
# The API and worker read the settings below (backend/app/core/config.py).

APP_ENV=development
LOG_LEVEL=INFO

# Phase 2: API, persistence, and worker
DATABASE_URL=postgresql+psycopg://eval_user:change_me@localhost:5432/llm_eval
REDIS_URL=redis://localhost:6379/0
# celery = enqueue runs on Redis for the worker (normal); inline = run inside the
# API process (tests/local experiments only; rejected when APP_ENV=production).
RUN_DISPATCHER=celery
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
MAX_CASES_PER_RUN=1000
MAX_MODELS_PER_RUN=10
MAX_REQUEST_BYTES=10485760
# Used by docker-compose.yml for the local PostgreSQL container.
POSTGRES_PASSWORD=change_me

# Phase 3: optional provider credentials (not yet implemented). Model
# configurations reference these by name via `secret_reference`.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Phase 7: authentication (not yet implemented). Do not deploy publicly before it exists.
SECRET_KEY=replace_with_a_long_random_value
