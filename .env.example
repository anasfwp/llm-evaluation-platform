# Copy to .env and fill in only what you use. Never commit .env.
#
# Phase 1 (current): the CLI and the deterministic fake provider need
# no environment variables at all. The settings below are documented
# for upcoming phases and are not read by the code yet.

APP_ENV=development
LOG_LEVEL=INFO

# Phase 2: API, persistence, and worker (not yet implemented)
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://eval_user:change_me@localhost:5432/llm_eval
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace_with_a_long_random_value

# Phase 3: optional provider credentials (not yet implemented)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

DEFAULT_REQUEST_TIMEOUT_SECONDS=60
MAX_RUN_CONCURRENCY=5
MAX_CASES_PER_RUN=1000
MAX_RETRIES=2
STORE_RAW_CONTENT=true
RAW_CONTENT_RETENTION_DAYS=30
